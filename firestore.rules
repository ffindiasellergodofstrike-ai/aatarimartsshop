rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny all direct client SDK reads and writes by default.
    match /{document=**} {
      allow read, write: if false;
    }

    // Orders contain customer PII, payment reconciliation state, and access hashes.
    // All order creation, guest lookups, and PayU updates run exclusively via
    // server-side Vercel Functions using Firebase Admin SDK, which bypasses rules.
    match /orders/{transactionId} {
      allow get, list, create, update, delete: if false;
    }
  }
}
